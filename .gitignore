# Create .gitignore
echo "# Dependencies
node_modules/
.pnpm-store/
.yarn/

# Build outputs
dist/
build/
.next/
out/
.env.local
.env.production

# Backend
backend/node_modules/
backend/dist/
backend/.env
backend/prisma/*.db
backend/prisma/*.db-journal

# Frontend
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# OS
Thumbs.db
Desktop.ini

# Backup files
*.bak
*.tmp
*.temp" > .gitignore