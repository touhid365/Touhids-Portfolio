{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://touhid-backend.onrender.com/api"
  },
  "build": {
    "env": {
      "NODE_VERSION": "20.x"
    }
  }
}